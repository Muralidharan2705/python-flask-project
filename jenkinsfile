pipeline {
    agent any 

     environment {
           docker_image_name = 'muralidharan2705/pythonapp'
           docker_tag_name= 'latest'
           DOCKER_HUB = credentials('docker-hub-credentials')
        }

      stages { 
         stage('checkout') {
           steps {

             git branch:'test', url: 'https://github.com/Muralidharan2705/python-flask-project.git'
             sh ' echo passed'

          }
       }


       stage('build docker image') {
         steps {

                 sh ' docker build -t ${docker_image _name}:${docker_tag_name} .'

             }
          }
       stage('Docker login') {
          steps {
                sh 'echo ${DOCKER_HUB_PSW} | docker login -u ${DOCKER_HUB_USR}  --password-stdin'
                sh 'docker push ${docker_image _name}'
            }
        }
     }

post {

  always {
           sh 'echo Cleaning workspace.....'
           sh ' docker rmi ${docker_image _name}'
           cleanWs()
           }
    success {
          sh ' echo Docker build was pushed successfully'
        }
     failure {

        sh ' echo build has been failed'
       }
     }
 }
